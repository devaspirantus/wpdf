{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "sovereigneg": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "SovereignEG",
            "options": {
                "baseURL": "https://backend.sovereigneg.com/v1",
                "apiKey": "{env:SOVEREIGNEG_API_KEY}"
            },
            "models": {
                "SovereignEG/Qwen3.8-27B-FP8": {
                    "name": "SovereignEG/Qwen3.8-27B-FP8 (SovereignEG)",
                    "limit": {
                        "context": 30000,
                        "output": 8192
                    }
                }
            }
        }
    },
    "model": "sovereigneg/SovereignEG/Qwen3.8-27B-FP8",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "vendor/bin/sail",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
